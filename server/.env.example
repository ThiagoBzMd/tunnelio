# ============================================================
# Tunnelio server — every environment variable, with its default where it has one.
# Self-hosting: put the ones you set in deploy/.env (README, "Self-hosting"). Local development
# needs none of them (SQLite in server/data). Every setting is documented in docs/SPEC.md §11.5.
# ============================================================

# Required in production (the container refuses to start without it)
SECRET_KEY=change-me-generate-with-python-secrets

# Comma-separated. ALLOWED_HOSTS: every name the server is reached by (e.g. <server>.<your-tailnet>.ts.net);
# localhost and 127.0.0.1 are always added. The browser relay accepts the server's own address by itself;
# CSRF_TRUSTED_ORIGINS is only for a web app served from another address (development).
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Only behind a proxy or tunnel that always puts the visitor's address in a header of its own (and
# overwrites what the visitor sent): that header's name. Anywhere else a client could forge it and
# dodge the attempt limits, so leave it empty. (X-Forwarded-For is trusted only from the addresses in
# uvicorn's FORWARDED_ALLOW_IPS, by default only loopback.)
#CLIENT_IP_HEADER=X-Real-IP

# Storage. Default: SQLite inside DATA_DIR (in the image, the /data volume). Set DATABASE_URL for Postgres.
#DATA_DIR=/data
#DATABASE_URL=postgres://tunnelio:password@db:5432/tunnelio

# Channel layer. Empty = InMemoryChannelLayer (single process, UVICORN_WORKERS must be 1).
#REDIS_URL=redis://redis:6379/0
UVICORN_WORKERS=1

# The Django admin's path. On a server others can reach, use a path nobody can guess, and keep the
# admin off the public address (e.g. only through a private network).
ADMIN_URL_PATH=admin

# Accounts. A server only you use: create your account, then set false (others could sign up otherwise).
REGISTRATION_ENABLED=true
# Optional e-mail (verification + password reset). Empty = disabled.
#EMAIL_URL=smtp://user:password@smtp.example.com:465/?ssl=True   # empty = no e-mail verification, no password reset
DEFAULT_FROM_EMAIL=Tunnelio <noreply@example.com>
# The 6-digit codes sent by e-mail, and accounts that never confirmed theirs (defaults shown)
#EMAIL_CODE_TTL_MINUTES=15
#EMAIL_CODES_PER_HOUR=3
#EMAIL_CODE_MAX_ATTEMPTS=5
#UNVERIFIED_ACCOUNT_TTL_DAYS=7
# Optional second factor (authenticator app; defaults shown)
#TOTP_ISSUER=Tunnelio
#TOTP_MAX_FAILED=5
#TOTP_LOCK_MINUTES=15
# Optional bot check (a captcha widget) on login, sign-up, reset and resend: all five or none, as
# the widget's provider documents them: the keys, the address of the widget's script, the name of
# the object that script defines (it must offer render/remove), and the server-side check.
#BOT_CHECK_SITE_KEY=
#BOT_CHECK_SECRET_KEY=
#BOT_CHECK_SCRIPT_URL=https://…
#BOT_CHECK_GLOBAL=…
#BOT_CHECK_VERIFY_URL=https://…

# Model catalog: the Ollama library page fetched once a day (served to the app at /api/catalog/ollama)
#OLLAMA_LIBRARY_URL=https://ollama.com/library?sort=popular

# Update notice: the newest computer-app release, announced to the trays (their menu offers it).
# Both or nothing; the download page must be https.
#TRAY_LATEST_VERSION=1.0.1
#TRAY_DOWNLOAD_URL=https://…

# Limits (defaults shown)
DEVICES_MAX_PER_USER=20
RELAY_MAX_FRAME_BYTES=8388608
RELAY_CLIENT_FPS=20
RELAY_DEVICE_FPS=60
RELAY_BYTES_PER_MIN=67108864
RELAY_MAX_CLIENTS_PER_USER=10
RELAY_MAX_SESSIONS_PER_CLIENT=5
RELAY_IDLE_TIMEOUT_SECONDS=90
RELAY_LOG_RETENTION_DAYS=7
PAIR_TTL_SECONDS=300
PAIR_JOIN_RATE=5/minute

LOG_LEVEL=INFO
