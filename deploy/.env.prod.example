# deploy/.env.prod — production variables (git-ignored). Copy and fill.
SECRET_KEY=change-me
ALLOWED_HOSTS=app.tunnelio.app          # localhost/127.0.0.1 are added automatically (healthcheck)
CSRF_TRUSTED_ORIGINS=https://app.tunnelio.app
ADMIN_URL_PATH=change-me-obscure-path      # served only on :81 (loopback), for a private network in front
#CLIENT_IP_HEADER=X-Real-IP                # the header in which the proxy/tunnel in front puts the visitor's address
REGISTRATION_ENABLED=true
UVICORN_WORKERS=1
#REDIS_URL=redis://redis:6379/0
# Postgres (the db container reads POSTGRES_*; the server reads DATABASE_URL)
POSTGRES_USER=tunnelio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tunnelio
DATABASE_URL=postgres://tunnelio:change-me@db:5432/tunnelio
#EMAIL_URL=smtp://user:password@smtp.example.com:465/?ssl=True   # any SMTP provider
DEFAULT_FROM_EMAIL=Tunnelio <noreply@tunnelio.app>
# Optional bot check (a captcha widget): all five or none, as the widget's provider documents them
#BOT_CHECK_SITE_KEY=
#BOT_CHECK_SECRET_KEY=
#BOT_CHECK_SCRIPT_URL=https://…
#BOT_CHECK_GLOBAL=…
#BOT_CHECK_VERIFY_URL=https://…
# The public site's folder (its own image); default ../../site/landing next to this clone
#SITE_DIR=../../site/landing
TUNNELIO_IMAGE_TAG=latest
TUNNELIO_NGINX_TAG=latest

# Optional outbound tunnel connector (the `tunnel` service): your connector's image and command,
# plus whatever credentials it reads from the environment.
#COMPOSE_PROFILES=tunnel
#TUNNEL_IMAGE=
#TUNNEL_COMMAND=
